---
import { NAV } from '../config';
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-parchment/95 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="#top" class="flex items-center gap-3">
      <span
        class="grid h-9 w-9 place-items-center rounded-sm bg-ink font-serif text-sm font-bold tracking-tight text-parchment"
        >MLT</span
      >
      <span class="hidden text-sm font-semibold uppercase tracking-[0.15em] sm:inline"
        >Muslim Liberation Theology</span
      >
    </a>

    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-6 text-sm font-medium md:flex">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-ink/80 transition-colors hover:text-brick">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="#network"
        class="rounded-sm bg-brick px-4 py-2 text-sm font-semibold text-parchment transition-opacity hover:opacity-90"
        >Join the network</a
      >
    </div>
  </nav>
</header>
