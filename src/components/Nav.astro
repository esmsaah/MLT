---
import { NAV } from '../config';
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-parchment/95 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
    <a
      href="/#top"
      class="lg"
      aria-label="mlt, home"
      style="display:flex;align-items:center;height:44px;text-decoration:none;color:#17211B"
    >
      <span
        style="font-family:Georgia,Cambria,'Times New Roman',serif;font-size:32px;letter-spacing:-.01em;line-height:1;white-space:nowrap"
        >mlt<span
          style="position:relative;display:inline-block;width:.26em;height:1em;vertical-align:top"
          ><svg
            viewBox="-14 -10 28 20"
            aria-hidden="true"
            style="position:absolute;left:.11em;top:.79em;width:.6em;height:.43em;transform:translate(-50%,-50%);overflow:visible"
            ><circle class="home" r="2.6" fill="#9F2E26"></circle><g class="flight"
              ><path
                class="wing wl"
                d="M-2.5 -0.5 Q-7 -6 -13 -4.5"
                fill="none"
                stroke="#9F2E26"
                stroke-width="2"
                stroke-linecap="round"
              ></path><path
                class="wing wr"
                d="M2.5 -0.5 Q7 -6 13 -4.5"
                fill="none"
                stroke="#9F2E26"
                stroke-width="2"
                stroke-linecap="round"
              ></path><circle r="2.6" fill="#9F2E26"></circle></g
            ></svg
          ></span
        ></span
      >
    </a>

    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-6 text-sm font-medium md:flex">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-ink/80 transition-colors hover:text-brick">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="#network"
        class="rounded-sm bg-brick px-4 py-2 text-sm font-semibold text-parchment transition-opacity hover:opacity-90"
        >Join the network</a
      >
    </div>
  </nav>
</header>
