---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, ENDORSEMENTS } from '../config';

// Essays — authored in the /admin panel, one page each at /essays/<slug>
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const essayRuleColors = ['bg-ink', 'bg-brick', 'bg-gold'];

// Podcast episodes — authored in the /admin panel
const allEpisodes = (await getCollection('episodes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = allEpisodes.find((e) => e.data.featured) ?? allEpisodes[0];
const conversations = allEpisodes.filter((e) => e.id !== featured?.id).slice(0, 4);
---

<Base>
  <span id="top"></span>
  <Nav />

  <main>
    <!-- ============ HERO (direction A) ============ -->
    <section id="top" class="dk bg-forest2 text-parchment">
      <div
        class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 md:min-h-[760px] md:grid-cols-[1fr_300px] md:gap-16 md:py-24"
      >
        <!-- Giant title with the flying-dove "i" -->
        <h1
          class="auto replay font-serif"
          style="margin:0; font-weight:400; line-height:.9; letter-spacing:-.03em; font-size:clamp(3rem,11vw,150px)"
        >
          Muslim<br />
          <span style="font-style:italic;color:#C9A85E;white-space:nowrap"
            >Liberat<span style="position:relative;display:inline-block;line-height:1"
              >ı<svg
                viewBox="-14 -10 28 20"
                aria-hidden="true"
                style="position:absolute;left:.24em;top:.17em;width:.48em;height:.34em;transform:translate(-50%,-50%);overflow:visible"
                ><circle class="home" r="3.8" fill="#C9A85E"></circle><g class="flight"
                  ><path
                    class="wing wl"
                    d="M-2.5 -0.5 Q-7 -6 -13 -4.5"
                    fill="none"
                    stroke="#C9A85E"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  ></path><path
                    class="wing wr"
                    d="M2.5 -0.5 Q7 -6 13 -4.5"
                    fill="none"
                    stroke="#C9A85E"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  ></path><circle r="3.8" fill="#C9A85E"></circle></g
                ></svg
              >on</span
            ></span
          ><br />
          Theology
        </h1>

        <!-- Right column: tagline (above), cover, button (below) -->
        <div class="flex w-full max-w-[300px] flex-col gap-6 md:mx-auto">
          <p
            class="font-serif text-lg italic leading-relaxed"
            style="color:rgba(242,238,228,.86)"
          >
            {SITE.tagline}
          </p>
          <a
            href={SITE.buyUrl}
            target="_blank"
            rel="noopener"
            aria-label="The Wiley Blackwell Companion to Muslim Liberation Theologies on Wiley"
            style="box-shadow:0 30px 60px rgba(0,0,0,.35), 0 0 0 1px rgba(242,238,228,.14)"
          >
            <img
              src="/cover.png"
              alt="The Wiley Blackwell Companion to Muslim Liberation Theologies, front cover"
              width="300"
              height="426"
              class="block w-full object-cover object-right"
              style="aspect-ratio:300/426"
            />
          </a>
          <a
            class="btn self-start rounded-sm bg-brick px-6 py-3 font-semibold text-parchment transition-opacity hover:opacity-90"
            href={SITE.buyUrl}
            target="_blank"
            rel="noopener">Explore the Companion</a
          >
        </div>
      </div>
    </section>

    <!-- ============ STATEMENT (red band) ============ -->
    <section class="bg-brick text-white">
      <div class="mx-auto max-w-5xl px-5 py-16 md:py-20">
        <p class="font-serif text-3xl leading-snug md:text-4xl">
          Not simply a theology <span class="italic">about</span> liberation, but an Islamic mode
          of thought and praxis that emerges <span class="italic">from within</span> struggles for justice.
        </p>
      </div>
    </section>

    <!-- ============ WHAT IS MLT ============ -->
    <section id="what-is-mlt" class="scroll-mt-20 bg-parchment">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 md:grid-cols-2 md:gap-16">
        <h2 class="font-serif text-4xl leading-tight md:text-5xl">
          What is Muslim Liberation Theology?
        </h2>
        <div class="space-y-6 text-lg leading-relaxed text-ink/85">
          <p>
            Muslim Liberation Theology draws upon revelation, the Prophetic tradition, Muslim
            intellectual histories, and contemporary struggles to confront structures of
            domination and pursue spiritual, social, political, and epistemic liberation.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ THE COMPANION ============ -->
    <section id="companion" class="scroll-mt-20 bg-cream">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 md:grid-cols-2 md:gap-16">
        <!-- left: cover with an offset brick outline frame (not filled) -->
        <div class="flex justify-center py-4">
          <div class="relative">
            <div
              class="pointer-events-none absolute -bottom-4 -right-4 h-full w-full border-2 border-brick"
              aria-hidden="true"
            >
            </div>
            <img
              src="/cover.png"
              alt="The Wiley Blackwell Companion to Muslim Liberation Theologies — front cover"
              width="380"
              height="563"
              class="relative block w-[380px] max-w-full object-cover object-right"
              style="aspect-ratio: 320 / 474;"
            />
          </div>
        </div>

        <!-- right: heading + endorsements -->
        <div>
          <h2 class="font-serif text-5xl md:text-6xl">The Companion</h2>
          <div class="mt-8 divide-y divide-ink/15 border-t border-ink/15">
            {
              ENDORSEMENTS.map((e) => (
                <figure class="py-6">
                  <blockquote class="font-serif text-lg leading-relaxed text-ink">
                    “{e.quote}”
                  </blockquote>
                  <figcaption class="mt-3 text-sm text-ink/60">
                    <span class="font-semibold text-brick">{e.name}</span>{`, ${e.title}`}
                  </figcaption>
                </figure>
              ))
            }
          </div>
          <a
            href={SITE.buyUrl}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-block font-semibold text-brick hover:underline"
            >Discover the book →</a
          >
        </div>
      </div>
    </section>

    <!-- ============ CONVERSATIONS / PODCAST ============ -->
    <section id="conversations" class="scroll-mt-20 bg-forest text-parchment">
      <div class="mx-auto max-w-6xl px-5 py-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">
          Watch · Listen · Think
        </p>
        <h2 class="mt-4 font-serif text-4xl md:text-5xl">MLT Conversations</h2>
        <p class="mt-6 max-w-2xl text-lg text-parchment/80">
          The audiovisual journal of the project: sustained conversations with scholars, thinkers,
          and activists on Islam, liberation, decoloniality, and emancipatory praxis.
        </p>

        <div class="mt-12 grid gap-10 md:grid-cols-2">
          <!-- Featured player -->
          <div>
            {
              featured?.data.embed ? (
                <div set:html={featured.data.embed} />
              ) : (
                <a
                  href={featured?.data.link || SITE.podcast.youtubeUrl || '#'}
                  target="_blank"
                  rel="noopener"
                  class="group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-sm p-8"
                  style="background: linear-gradient(135deg, #4a1a15 0%, #1c0c09 100%);"
                >
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center font-serif text-[160px] font-bold leading-none text-white/5 select-none">
                    MLT
                  </span>
                  <span class="absolute left-8 top-8 grid h-14 w-14 place-items-center rounded-full border-2 border-white/70 text-lg text-white transition-transform group-hover:scale-105">
                    ▶
                  </span>
                  <div class="relative">
                    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-white/70">
                      {featured?.data.tag ?? 'Featured conversation'}
                    </p>
                    <p class="mt-2 font-serif text-2xl text-white">
                      {featured?.data.title ?? 'Coming soon'}
                    </p>
                  </div>
                </a>
              )
            }
          </div>

          <!-- List -->
          <ul class="divide-y divide-parchment/15 border-t border-parchment/15">
            {
              conversations.map((c) => (
                <li class="py-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gold">
                    {c.data.tag}
                  </p>
                  {c.data.link ? (
                    <a
                      href={c.data.link}
                      target="_blank"
                      rel="noopener"
                      class="mt-1 block font-serif text-xl text-parchment hover:text-gold"
                    >
                      {c.data.title}
                    </a>
                  ) : (
                    <p class="mt-1 font-serif text-xl text-parchment">{c.data.title}</p>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        {
          SITE.podcast.youtubeUrl && (
            <a
              href={SITE.podcast.youtubeUrl}
              target="_blank"
              rel="noopener"
              class="mt-10 inline-flex items-center gap-2 font-semibold text-gold hover:underline"
            >
              View the channel on YouTube →
            </a>
          )
        }
      </div>
    </section>

    <!-- ============ ESSAYS ============ -->
    <section id="essays" class="scroll-mt-20 bg-parchment">
      <div class="mx-auto max-w-6xl px-5 py-20">
        <!-- header -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/60">
            Ideas in Movement
          </p>
          <h2 class="mt-3 font-serif text-4xl leading-tight md:text-5xl">
            Essays &amp; interventions
          </h2>
        </div>

        <!-- three unboxed columns with colored top rules -->
        <div class="mt-14 grid gap-10 md:grid-cols-3">
          {
            essays.map((e, i) => (
              <a href={`/essays/${e.slug}`} class="group flex flex-col">
                <span class={`h-1 w-full ${essayRuleColors[i % essayRuleColors.length]}`} />
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-ink/60">
                  {e.data.tag}
                </p>
                <h3 class="mt-2 font-serif text-2xl leading-tight group-hover:text-brick">
                  {e.data.title}
                </h3>
                <p class="mt-3 flex-1 text-ink/70">{e.data.summary}</p>
                <span class="mt-6 text-xs font-semibold uppercase tracking-[0.15em] text-ink">
                  Read essay →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ NETWORK / NEWSLETTER (gold band) ============ -->
    <section id="network" class="scroll-mt-20 bg-gold text-ink">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 md:grid-cols-2 md:gap-16">
        <!-- left: heading + intro -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/70">
            The MLT Network
          </p>
          <h2 class="mt-4 font-serif text-4xl leading-[1.1] md:text-6xl">
            A field is built through conversation.
          </h2>
          <p class="mt-6 max-w-md text-lg text-ink/80">
            Receive new essays, conversations, events, and developments in Muslim Liberation Theology.
          </p>
        </div>

        <!-- right: email form (underline input + dark button) -->
        <form
          class="flex items-end gap-4"
          action={SITE.newsletterActionUrl || '#'}
          method="post"
        >
          <input
            type="email"
            name="email"
            required
            placeholder="Your email address"
            class="min-w-0 flex-1 border-0 border-b-2 border-ink/40 bg-transparent px-1 py-3 text-ink placeholder:text-ink/50 focus:border-ink focus:outline-none focus:ring-0"
          />
          <button
            type="submit"
            class="whitespace-nowrap rounded-sm bg-ink px-6 py-3 font-semibold text-parchment transition-opacity hover:opacity-90"
            >Join the network</button
          >
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>
