---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, ENDORSEMENTS } from '../config';

// Essays — authored in the /admin panel, one page each at /essays/<slug>
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const essayRuleColors = ['bg-ink', 'bg-brick', 'bg-gold'];

// Podcast episodes — authored in the /admin panel
const allEpisodes = (await getCollection('episodes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = allEpisodes.find((e) => e.data.featured) ?? allEpisodes[0];
const conversations = allEpisodes.filter((e) => e.id !== featured?.id).slice(0, 4);
---

<Base>
  <span id="top"></span>
  <Nav />

  <main>
    <!-- ============ HERO (redesign) ============ -->
    <section id="top" class="dk text-parchment" style="background:#1B2620">
      <div
        class="mx-auto grid max-w-6xl gap-12 px-5 py-16 md:grid-cols-[1fr_360px] md:gap-20 md:py-20"
      >
        <!-- Title -->
        <div>
          <h1
            class="font-serif"
            style="margin:0; font-weight:400; line-height:.905; letter-spacing:-.035em; font-size:clamp(3rem,10vw,126px)"
          >
            Muslim<br />
            <span style="font-style:italic;color:#C9A85E">Liberation</span><br />
            Theology
          </h1>
        </div>

        <!-- Right: tagline, aligned to the bottom of the title on desktop -->
        <div class="md:self-end md:mb-[6px]">
          <p
            class="font-serif"
            style="font-size:clamp(20px,1.75vw,25px);line-height:1.36;letter-spacing:-.005em;color:rgba(242,238,228,.9);text-wrap:pretty"
          >
            A living intellectual project that reclaims Islam as a resource for confronting
            domination and <em style="font-style:italic;color:#C9A85E">imagining liberation.</em>
          </p>
        </div>
      </div>
    </section>

    <!-- ============ STATEMENT (red band) ============ -->
    <section id="what-is-mlt" class="scroll-mt-20 bg-brick text-parchment">
      <div class="mx-auto max-w-6xl px-5 py-8 md:px-[72px]">
        <p
          class="max-w-[1010px] font-serif text-2xl leading-snug"
          style="letter-spacing:-.005em;color:rgba(242,238,228,.95)"
        >
          Not simply a theology <em style="font-style:italic;color:#F7E9C9">about</em> liberation,
          but an Islamic mode of thought and praxis that emerges from
          <em style="font-style:italic;color:#F7E9C9">within</em> struggles for justice.
        </p>
      </div>
    </section>

    <!-- ============ THE COMPANION (redesign) ============ -->
    <section id="companion" class="scroll-mt-20 bg-parchment">
      <div class="mx-auto grid max-w-[1240px] gap-12 px-5 py-20 md:grid-cols-[485px_1fr] md:items-stretch md:gap-16">
        <!-- cover, auto-stretched to match the height of the text block on desktop -->
        <div class="relative mx-auto w-full max-w-[360px] md:mx-0 md:h-[calc(100%+24px)] md:-translate-y-6 md:w-[485px] md:max-w-none">
          <img
            src="/cover.png"
            alt="The Wiley Blackwell Companion to Muslim Liberation Theologies — front cover"
            width="485"
            height="689"
            class="block w-full object-cover object-right md:absolute md:inset-0 md:h-full md:w-full"
          />
          <span
            class="absolute -left-4 bottom-16 z-10 bg-brick px-3 py-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-parchment"
            >Pre-order</span
          >
        </div>

        <!-- right: heading, meta, quotes, CTAs -->
        <div>
          <h2 class="font-serif text-5xl leading-tight md:text-6xl">The Companion</h2>
          <p class="mt-4 text-sm uppercase tracking-wide text-ink/55">
            592 pages · 30 contributions · Wiley Blackwell · December 2026
          </p>

          <div class="mt-8 divide-y divide-ink/15 border-t border-ink/15">
            {
              ENDORSEMENTS.map((e) => (
                <figure class="py-4">
                  <blockquote class="font-serif text-lg italic leading-snug text-ink/90">
                    “{e.quote}”
                  </blockquote>
                  <figcaption class="mt-2 text-xs uppercase tracking-wide text-ink/50">
                    {e.name} · {e.org ?? e.title}
                  </figcaption>
                </figure>
              ))
            }
          </div>

          <div class="mt-8">
            <a
              href={SITE.buyUrl}
              target="_blank"
              rel="noopener"
              class="inline-block rounded-sm bg-brick px-6 py-3 font-semibold text-parchment transition-opacity hover:opacity-90"
              >Pre-order the Companion</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CONVERSATIONS / PODCAST ============ -->
    <section id="conversations" class="scroll-mt-20 bg-forest text-parchment">
      <div class="mx-auto max-w-6xl px-5 py-20">
        <h2 class="font-serif text-4xl md:text-5xl">MLT Conversations</h2>
        <p class="mt-6 max-w-2xl text-lg text-parchment/80">
          The audiovisual journal of the project: sustained conversations with scholars, thinkers,
          and activists on Islam, liberation, decoloniality, and emancipatory praxis.
        </p>

        <div class="mt-12 grid gap-10 md:grid-cols-2">
          <!-- Featured player -->
          <div>
            {
              featured?.data.embed ? (
                <div set:html={featured.data.embed} />
              ) : (
                <a
                  href={SITE.podcast.youtubeUrl || featured?.data.link || '#'}
                  target="_blank"
                  rel="noopener"
                  class="group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-sm p-8"
                  style="background: linear-gradient(135deg, #4a1a15 0%, #1c0c09 100%);"
                >
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center font-serif text-[160px] font-bold leading-none text-white/5 select-none">
                    MLT
                  </span>
                  <span class="absolute left-8 top-8 grid h-14 w-14 place-items-center rounded-full border-2 border-white/70 text-lg text-white transition-transform group-hover:scale-105">
                    ▶
                  </span>
                  <div class="relative">
                    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-white/70">
                      {featured?.data.tag ?? 'Featured conversation'}
                    </p>
                    <p class="mt-2 font-serif text-2xl text-white">
                      {featured?.data.title ?? 'Coming soon'}
                    </p>
                  </div>
                </a>
              )
            }
          </div>

          <!-- List -->
          <ul class="divide-y divide-parchment/15 border-t border-parchment/15">
            {
              conversations.map((c) => (
                <li class="py-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gold">
                    {c.data.tag}
                  </p>
                  {SITE.podcast.youtubeUrl || c.data.link ? (
                    <a
                      href={SITE.podcast.youtubeUrl || c.data.link}
                      target="_blank"
                      rel="noopener"
                      class="mt-1 block font-serif text-xl text-parchment hover:text-gold"
                    >
                      {c.data.title}
                    </a>
                  ) : (
                    <p class="mt-1 font-serif text-xl text-parchment">{c.data.title}</p>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-semibold text-gold">
          {
            SITE.podcast.youtubeUrl && (
              <a href={SITE.podcast.youtubeUrl} target="_blank" rel="noopener" class="hover:underline">
                Watch on YouTube →
              </a>
            )
          }
          {
            SITE.podcast.spotifyUrl && (
              <a href={SITE.podcast.spotifyUrl} target="_blank" rel="noopener" class="hover:underline">
                Listen on Spotify →
              </a>
            )
          }
        </div>
      </div>
    </section>

    <!-- ============ ESSAYS ============ -->
    <section id="essays" class="scroll-mt-20 bg-parchment">
      <div class="mx-auto max-w-6xl px-5 py-20">
        <!-- header -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/60">
            Ideas in Movement
          </p>
          <h2 class="mt-3 font-serif text-4xl leading-tight md:text-5xl">
            Essays &amp; interventions
          </h2>
        </div>

        <!-- three unboxed columns with colored top rules -->
        <div class="mt-14 grid gap-10 md:grid-cols-3">
          {
            essays.map((e, i) => (
              <a href={`/essays/${e.slug}`} class="group flex flex-col">
                <span class={`h-1 w-full ${essayRuleColors[i % essayRuleColors.length]}`} />
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-ink/60">
                  {e.data.tag}
                </p>
                <h3 class="mt-2 font-serif text-2xl leading-tight group-hover:text-brick">
                  {e.data.title}
                </h3>
                <p class="mt-3 flex-1 text-ink/70">{e.data.summary}</p>
                <span class="mt-6 text-xs font-semibold uppercase tracking-[0.15em] text-ink">
                  Read essay →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ NETWORK / NEWSLETTER (gold band) ============ -->
    <section id="network" class="scroll-mt-20 bg-gold text-ink">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 md:grid-cols-2 md:gap-16">
        <!-- left: heading + intro -->
        <div>
          <h2 class="font-serif text-4xl leading-[1.1] md:text-6xl">
            A field is built through conversation.
          </h2>
          <p class="mt-6 max-w-md text-lg text-ink/80">
            Receive new essays, conversations, events, and developments in Muslim Liberation Theology.
          </p>
        </div>

        <!-- right: email form (underline input + dark button) -->
        <form
          class="flex items-end gap-4"
          action={SITE.newsletterActionUrl || '#'}
          method="post"
        >
          <input
            type="email"
            name="email"
            required
            placeholder="Your email address"
            class="min-w-0 flex-1 border-0 border-b-2 border-ink/40 bg-transparent px-1 py-3 text-ink placeholder:text-ink/50 focus:border-ink focus:outline-none focus:ring-0"
          />
          <button
            type="submit"
            class="whitespace-nowrap rounded-sm bg-ink px-6 py-3 font-semibold text-parchment transition-opacity hover:opacity-90"
            >Join the network</button
          >
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>
