---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, ENDORSEMENTS } from '../config';

// Essays — authored in the /admin panel, one page each at /essays/<slug>
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const essayRuleColors = ['bg-ink', 'bg-brick', 'bg-gold'];

// Podcast episodes — authored in the /admin panel
const allEpisodes = (await getCollection('episodes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = allEpisodes.find((e) => e.data.featured) ?? allEpisodes[0];
const conversations = allEpisodes.filter((e) => e.id !== featured?.id).slice(0, 4);
---

<Base>
  <span id="top"></span>
  <Nav />

  <main>
            <!-- ============ HERO (redesign) ============ -->
    <section id="top" class="dk text-parchment" style="background:#1B2620">
      <div class="hero-inner">
        <!-- Title -->
        <div>
          <h1
            style="
              margin:0;
              font-family:Georgia,Cambria,'Times New Roman',serif;
              font-weight:400;
              line-height:.905;
              letter-spacing:-.035em;
              font-size:clamp(64px,10vw,126px);
            "
          >
            Muslim<br />
            <span style="font-style:italic;color:#C9A85E">Liberation</span><br />
            Theology
          </h1>
        </div>

        <!-- Right column -->
        <div style="align-self:center;padding-bottom:0;transform:none">

          <!-- Qur'an -->
          <div style="margin-bottom:34px">

            <div
              lang="ar"
              dir="rtl"
              style="
                font-family:Georgia,Cambria,'Times New Roman',serif;
                direction:rtl;
                text-align:left;
                color:#C9A85E;
                font-size:34px;
                line-height:1.65;
                margin-bottom:7px;
              "
            >
              <span>لِيَقُومَ النَّاسُ بِالْقِسْطِ</span>
              <span
                aria-label="Ayah 25"
                style="
                  display:inline-flex;
                  width:34px;
                  height:34px;
                  margin-left:9px;
                  vertical-align:middle;
                  color:#C9A85E;
                "
              >
                <svg
                  viewBox="0 0 26 26"
                  width="34"
                  height="34"
                  aria-hidden="true"
                >
                  <path
                    d="M13 1.5
                       C14.8 4.2 16.1 4.8 18.9 4.2
                       C18.3 7 18.9 8.3 21.5 10
                       C18.9 11.7 18.3 13 18.9 15.8
                       C16.1 15.2 14.8 15.8 13 18.5
                       C11.2 15.8 9.9 15.2 7.1 15.8
                       C7.7 13 7.1 11.7 4.5 10
                       C7.1 8.3 7.7 7 7.1 4.2
                       C9.9 4.8 11.2 4.2 13 1.5Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.9"
                  />
                  <circle
                    cx="13"
                    cy="10"
                    r="5.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.7"
                  />
                  <text
                    x="13"
                    y="13"
                    text-anchor="middle"
                    font-family="Arial, Helvetica, sans-serif"
                    font-size="8"
                    fill="currentColor"
                  >٢٥</text>
                </svg>
              </span>
              </span>
            </div>

            <div
              style="
                font-family:Georgia,Cambria,'Times New Roman',serif;
                color:rgba(242,238,228,.92);
                font-size:17px;
                line-height:1.45;
              "
            >
              “…that people may uphold justice.”
            </div>

            <div
              style="
                margin-top:7px;
                color:rgba(242,238,228,.52);
                font-family:Arial,Helvetica,system-ui,sans-serif;
                font-size:10px;
                font-weight:600;
                letter-spacing:.16em;
                text-transform:uppercase;
              "
            >
              Qur’an 57:25
            </div>

          </div>

          <!-- Main statement -->
          <p
            style="
              font-family:Georgia,Cambria,'Times New Roman',serif;
              font-size:clamp(20px,1.75vw,25px);
              line-height:1.36;
              letter-spacing:-.005em;
              color:rgba(242,238,228,.9);
              margin:0;
            "
          >
            An intellectual project grounded in Islamic principles of
            <em style="font-style:italic;color:#C9A85E">justice</em>
            and carried by Muslims who bear
            <em style="font-style:italic;color:#C9A85E">freedom</em>
            as a trust.
          </p>

        </div>
      </div>
    </section>

<!-- ============ STATEMENT (red band) ============ -->
    <section id="what-is-mlt" class="bg-brick text-parchment">
      <div class="mlt-quotes-wrap">
        <div class="mlt-quotes-grid">

          <!-- Quote 1 -->
          <figure
            style="
              display:flex;
              flex-direction:column;
              gap:14px;
              margin:0;
            "
          >
            <blockquote
              style="
                margin:0;
                font-family:Georgia,Cambria,'Times New Roman',serif;
                font-size:17px;
                line-height:1.45;
                letter-spacing:-.005em;
                color:rgba(242,238,228,.96);
                text-wrap:pretty;
                text-indent:-.42em;
              "
            >
              “Not a theology <em style="color:#F7E9C9;">about</em> liberation, but theology done from <em style="color:#F7E9C9;">within</em> the struggle, where spirituality becomes responsibility and remembrance becomes resistance.”
            </blockquote>

            <figcaption
              style="
                margin-top:auto;
                height:38px;
                display:flex;
                flex-direction:column;
                justify-content:flex-start;
                gap:4px;
                font-family:Arial,Helvetica,sans-serif;
                font-size:13px;
                line-height:1.4;
              "
            >
              <span style="font-weight:600;color:#F2EEE4;">
                Emin Poljarević &amp; Ivan Ejub Kostić
              </span>
              <a
                href="https://onlinelibrary.wiley.com/doi/10.1002/9781394282517.ch1"
                target="_blank"
                rel="noopener"
                style="
                  color:rgba(242,238,228,.75);
                  text-decoration:underline;
                  text-decoration-color:rgba(242,238,228,.3);
                  text-underline-offset:4px;
                "
              >
                <em>Setting the Stage: Situating the Muslim Liberation Theology</em> · Chapter 1, The Companion
              </a>
            </figcaption>
          </figure>

          <!-- Quote 2 -->
          <figure
            style="
              display:flex;
              flex-direction:column;
              gap:14px;
              margin:0;
            "
          >
            <blockquote
              style="
                margin:0;
                font-family:Georgia,Cambria,'Times New Roman',serif;
                font-size:17px;
                line-height:1.45;
                letter-spacing:-.005em;
                color:rgba(242,238,228,.96);
                text-wrap:pretty;
                text-indent:-.42em;
              "
            >
              “It is not the Islamic that liberates. It is the Muslim who dares to live by Islamic principles as liberation.”
            </blockquote>

            <figcaption
              style="
                margin-top:auto;
                height:38px;
                display:flex;
                flex-direction:column;
                justify-content:flex-start;
                gap:4px;
                font-family:Arial,Helvetica,sans-serif;
                font-size:13px;
                line-height:1.4;
              "
            >
              <span style="font-weight:600;color:#F2EEE4;">
                Emin Poljarević &amp; Ivan Ejub Kostić
              </span>
              <a
                href="https://onlinelibrary.wiley.com/doi/10.1002/9781394282517.ch1"
                target="_blank"
                rel="noopener"
                style="
                  color:rgba(242,238,228,.75);
                  text-decoration:underline;
                  text-decoration-color:rgba(242,238,228,.3);
                  text-underline-offset:4px;
                "
              >
                <em>Setting the Stage: Situating the Muslim Liberation Theology</em> · Chapter 1, The Companion
              </a>
            </figcaption>
          </figure>

          <!-- Quote 3 -->
          <figure
            style="
              display:flex;
              flex-direction:column;
              gap:14px;
              margin:0;
            "
          >
            <blockquote
              style="
                margin:0;
                font-family:Georgia,Cambria,'Times New Roman',serif;
                font-size:17px;
                line-height:1.45;
                letter-spacing:-.005em;
                color:rgba(242,238,228,.96);
                text-wrap:pretty;
                text-indent:-.42em;
              "
            >
              “Liberation theology is not a settled doctrine. It is a mode of reasoning under pressure, and it is often forged where the cost of speech is high.”
            </blockquote>

            <figcaption
              style="
                margin-top:auto;
                height:38px;
                display:flex;
                flex-direction:column;
                justify-content:flex-start;
                gap:4px;
                font-family:Arial,Helvetica,sans-serif;
                font-size:13px;
                line-height:1.4;
              "
            >
              <span style="font-weight:600;color:#F2EEE4;">
                Amb. Ebrahim Rasool
              </span>
              <a
                href="https://onlinelibrary.wiley.com/doi/10.1002/9781394282517.fmatter"
                target="_blank"
                rel="noopener"
                style="
                  color:rgba(242,238,228,.75);
                  text-decoration:underline;
                  text-decoration-color:rgba(242,238,228,.3);
                  text-underline-offset:4px;
                "
              >
                Foreword · The Companion
              </a>
            </figcaption>
          </figure>

        </div>
      </div>

      <style>
        /* Desktop: preserve the existing composition */
        @media (min-width: 768px) {
          #what-is-mlt .mlt-quotes-wrap {
            width: min(1152px, calc(100% - 40px));
            margin: auto;
            padding: 48px 0;
          }

          #what-is-mlt .mlt-quotes-grid {
            display: grid;
            grid-template-columns: 330px 330px minmax(0, 1fr);
            column-gap: 56px;
          }
        }

        /* Mobile */
        @media (max-width: 767px) {
          #what-is-mlt {
            background: transparent !important;
            padding: 0 !important;
          }

          #what-is-mlt .mlt-quotes-wrap {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
          }

          #what-is-mlt .mlt-quotes-grid {
            display: flex !important;
            flex-direction: column !important;
            gap: 0 !important;
            width: 100% !important;
          }

          #what-is-mlt figure {
            box-sizing: border-box;
            width: 100%;
            margin: 0 !important;
            padding: 48px 24px 44px !important;
            display: flex !important;
            flex-direction: column !important;
            gap: 0 !important;
          }

          #what-is-mlt figure:nth-child(1),
          #what-is-mlt figure:nth-child(3) {
            background: #9F2E26;
            color: #F2EEE4;
          }

          #what-is-mlt figure:nth-child(2) {
            background: #F2EEE4;
            color: #17211B;
          }

          #what-is-mlt blockquote {
            margin: 0 0 16px !important;
            padding: 0 !important;
            font-family: Georgia, Cambria, "Times New Roman", serif !important;
            font-size: 21px !important;
            line-height: 1.36 !important;
            letter-spacing: -0.005em !important;
            text-wrap: pretty;
            text-indent: 0 !important;
          }

          #what-is-mlt figure:nth-child(1) blockquote,
          #what-is-mlt figure:nth-child(3) blockquote {
            color: #F2EEE4 !important;
          }

          #what-is-mlt figure:nth-child(2) blockquote {
            color: #17211B !important;
          }

          #what-is-mlt figure:nth-child(1) blockquote em,
          #what-is-mlt figure:nth-child(3) blockquote em {
            color: #F7E9C9 !important;
          }

          #what-is-mlt figure:nth-child(2) blockquote em {
            color: #9F2E26 !important;
          }

          #what-is-mlt figcaption {
            margin: 0 !important;
            padding: 0 !important;
            height: auto !important;
            display: flex !important;
            flex-direction: column !important;
            gap: 0 !important;
            font-family: Arial, Helvetica, sans-serif !important;
            font-size: 13px !important;
            line-height: 1.45 !important;
          }

          #what-is-mlt figcaption > span {
            margin: 0 0 2px !important;
            font-weight: 600 !important;
          }

          #what-is-mlt figcaption > span::before {
            content: "— ";
          }

          #what-is-mlt figure:nth-child(1) figcaption > span,
          #what-is-mlt figure:nth-child(3) figcaption > span {
            color: #F2EEE4 !important;
          }

          #what-is-mlt figure:nth-child(2) figcaption > span {
            color: #17211B !important;
          }

          #what-is-mlt figcaption a {
            text-decoration: none !important;
          }

          #what-is-mlt figure:nth-child(1) figcaption a,
          #what-is-mlt figure:nth-child(3) figcaption a {
            color: rgba(242, 238, 228, .72) !important;
          }

          #what-is-mlt figure:nth-child(2) figcaption a {
            color: rgba(23, 33, 27, .65) !important;
          }
        }
      </style>
    </section>

    <!-- ============ THE COMPANION (redesign) ============ -->
    <section id="companion" class="bg-parchment">
      <div class="mx-auto grid max-w-[1240px] gap-12 px-5 py-20 md:grid-cols-[485px_1fr] md:items-stretch md:gap-16">
        <!-- cover, auto-stretched to match the height of the text block on desktop -->
        <div class="relative mx-auto aspect-[485/689] w-full max-w-[360px] md:mx-0 md:h-[calc(100%+24px)] md:-translate-y-6 md:w-[485px] md:max-w-none md:aspect-auto">
          <img
            src="/cover-hq.png"
            alt="The Wiley Blackwell Companion to Muslim Liberation Theologies — front cover"
            width="485"
            height="689"
            class="block h-full w-full object-cover object-right md:absolute md:inset-0 md:h-full md:w-full"
          />
        </div>

        <!-- right: heading, meta, quotes, CTAs -->
        <div>
          <h2 class="font-serif text-5xl leading-tight md:text-6xl">The Companion</h2>
          <p class="mt-4 text-sm uppercase tracking-wide text-ink/55">
            592 pages · 32 chapters · five parts · Sunni and Shīʿī voices from West Africa to India, Morocco to Brazil and Malaysia
          </p>

          <div class="mt-8 divide-y divide-ink/15 border-t border-ink/15">
            {
              ENDORSEMENTS.map((e) => (
                <figure class="py-4">
                  <blockquote class="font-serif text-lg italic leading-snug text-ink/90">
                    “{e.quote}”
                  </blockquote>
                  <figcaption class="mt-2 text-xs uppercase tracking-wide text-ink/50">
                    {e.name} · {e.org ?? e.title}
                  </figcaption>
                </figure>
              ))
            }
          </div>

          <div class="mt-8">
            <a
              href={SITE.buyUrl}
              target="_blank"
              rel="noopener"
              class="inline-block rounded-sm bg-brick px-6 py-3 font-semibold text-parchment transition-opacity hover:opacity-90"
              >Order the Companion</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CONVERSATIONS / PODCAST ============ -->
    <section id="conversations" class="bg-forest text-parchment">
      <div class="mx-auto max-w-6xl px-5 py-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">
          Listen. Reflect. Act.
        </p>
        <h2 class="mt-3 font-serif text-4xl leading-tight md:text-5xl">
          MLT Conversations
        </h2>
        <p class="mt-6 max-w-2xl text-lg text-parchment/80">
          The audiovisual journal of the project: sustained conversations with scholars, thinkers,
          and activists on Islam, liberation, decoloniality, and emancipatory praxis.
        </p>

        <div class="mt-12 grid gap-10 md:grid-cols-2">
          <!-- Featured player -->
          <div>
            {
              featured?.data.embed ? (
                <div set:html={featured.data.embed} />
              ) : (
                <a
                  href={SITE.podcast.youtubeUrl || featured?.data.link || '#'}
                  target="_blank"
                  rel="noopener"
                  class="group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-sm p-8"
                  style="background: linear-gradient(135deg, #4a1a15 0%, #1c0c09 100%);"
                >
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center font-serif text-[160px] font-bold leading-none text-white/5 select-none">
                    MLT
                  </span>
                  <span class="absolute left-8 top-8 grid h-14 w-14 place-items-center rounded-full border-2 border-white/70 text-lg text-white transition-transform group-hover:scale-105">
                    ▶
                  </span>
                  <div class="relative">
                    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-white/70">
                      {featured?.data.tag ?? 'Featured conversation'}
                    </p>
                    <p class="mt-2 font-serif text-2xl text-white">
                      {featured?.data.title ?? 'Coming soon'}
                    </p>
                  </div>
                </a>
              )
            }
          </div>

          <!-- List -->
          <ul class="divide-y divide-parchment/15 border-t border-parchment/15">
            {
              conversations.map((c) => (
                <li class="py-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gold">
                    {c.data.tag}
                  </p>
                  {SITE.podcast.youtubeUrl || c.data.link ? (
                    <a
                      href={SITE.podcast.youtubeUrl || c.data.link}
                      target="_blank"
                      rel="noopener"
                      class="mt-1 block font-serif text-xl text-parchment hover:text-gold"
                    >
                      {c.data.title}
                    </a>
                  ) : (
                    <p class="mt-1 font-serif text-xl text-parchment">{c.data.title}</p>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-semibold text-gold">
          {
            SITE.podcast.youtubeUrl && (
              <a href={SITE.podcast.youtubeUrl} target="_blank" rel="noopener" class="hover:underline">
                Watch on YouTube →
              </a>
            )
          }
          {
            SITE.podcast.spotifyUrl && (
              <a href={SITE.podcast.spotifyUrl} target="_blank" rel="noopener" class="hover:underline">
                Listen on Spotify →
              </a>
            )
          }
        </div>
      </div>
    </section>

    <!-- ============ ESSAYS ============ -->
    <section id="essays" class="bg-parchment">
      <div class="mx-auto max-w-6xl px-5 py-20">
        <!-- header -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/60">
            Ideas in Movement
          </p>
          <h2 class="mt-3 font-serif text-4xl leading-tight md:text-5xl">
            Essays &amp; interventions
          </h2>
        </div>

        <!-- three unboxed columns with colored top rules -->
        <div class="mt-14 grid gap-10 md:grid-cols-3">
          {
            essays.map((e, i) => (
              <a href={`/essays/${e.slug}`} class="group flex flex-col">
                <span class={`h-1 w-full ${essayRuleColors[i % essayRuleColors.length]}`} />
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-ink/60">
                  {e.data.tag}
                </p>
                <h3 class="mt-2 font-serif text-2xl leading-tight group-hover:text-brick">
                  {e.data.title}
                </h3>
                <p class="mt-3 flex-1 text-ink/70">{e.data.summary}</p>
                <span class="mt-6 text-xs font-semibold uppercase tracking-[0.15em] text-ink">
                  Read essay →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ NETWORK / NEWSLETTER (gold band) ============ -->
    <section id="network" class="bg-gold text-ink">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 md:grid-cols-2 md:gap-16">
        <!-- left: heading + intro -->
        <div>
          <h2 class="font-serif text-4xl leading-[1.1] md:text-6xl">
            A field is measured by the questions it dares to ask.
          </h2>
          <p class="mt-6 max-w-md text-lg text-ink/80">
            Receive new essays, conversations, and events, and bring your own questions to the network.
          </p>
        </div>

        <!-- right: email form (underline input + dark button) -->
        <form
          class="flex items-end gap-4"
          action={SITE.newsletterActionUrl || '#'}
          method="post"
        >
          <input
            type="email"
            name="email"
            required
            placeholder="Your email address"
            class="min-w-0 flex-1 border-0 border-b-2 border-ink/40 bg-transparent px-1 py-3 text-ink placeholder:text-ink/50 focus:border-ink focus:outline-none focus:ring-0"
          />
          <button
            type="submit"
            class="whitespace-nowrap rounded-sm bg-ink px-6 py-3 font-semibold text-parchment transition-opacity hover:opacity-90"
            >Join the network</button
          >
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>
